# Project Settings
PROJECT_NAME="TwitterOS Backend"
API_V1_STR="/api/v1"

# Database
# Database
# Use postgresql://... for standard dev (localhost)
DATABASE_URL="postgresql://twitteros:twitteros@localhost:5432/twitteros"

# Postgres (Docker)
POSTGRES_USER=twitteros
POSTGRES_PASSWORD=twitteros
POSTGRES_DB=twitteros

# Apify
# Single key
APIFY_KEY=
# Multiple keys (comma-separated)
APIFY_KEYS=

# VTU.ng API
# Base URL
VTU_BASE_URL="https://vtu.ng/wp-json"
# Single credential
VTU_USERNAME=
VTU_PASSWORD=
# Multiple credentials (user1:pass1,user2:pass2)
VTU_CREDENTIALS=

# Security
# Generate a secure key for production: openssl rand -hex 32
SECRET_KEY="your-super-secret-key-change-in-production"
ALGORITHM="HS256"
# 7 days in minutes: 10080
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Redis
REDIS_URL="redis://localhost:6379/0"

# CORS
# Comma-separated list of origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"
